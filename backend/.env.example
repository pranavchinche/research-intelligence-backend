# ============================================================================
# Backend environment configuration
# Copy this file to `.env` and set the values for your target environment.
# Do NOT commit .env with real secrets to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_NAME=Research Intelligence Platform
APP_VERSION=1.0.0
APP_ENV=production

HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@hostname:5432/research_platform

# ---------------------------------------------------------------------------
# CORS — comma-separated origins that may call this API
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:3001

# ---------------------------------------------------------------------------
# Authentication / JWT (for auth implementation later)
# ---------------------------------------------------------------------------
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Google Drive PDF Storage
# Leave blank to use local temporary file storage instead.
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Local PDF storage (used only when Google Drive is not configured)
# Leave blank for auto-created temp directories.
# ---------------------------------------------------------------------------
PDF_STORAGE_DIR=
PDF_DOWNLOAD_DIR=

# ---------------------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_ENABLED=false

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_ENABLED=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_ENABLED=true

LLM_DEFAULT_PROVIDER=ollama
LLM_FALLBACK_CHAIN=ollama,gemini

# LLM Generation Settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120.0

# ---------------------------------------------------------------------------
# Redis (leave blank to run without cache)
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ---------------------------------------------------------------------------
# Upload Limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=200

# ---------------------------------------------------------------------------
# Connectivity
# ---------------------------------------------------------------------------
CONNECTIVITY_CHECK_INTERVAL=30
CONNECTIVITY_TIMEOUT=5.0
