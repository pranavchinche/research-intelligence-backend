# Research Intelligence Platform - Backend Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env with real credentials.

APP_NAME=Research Intelligence Platform
APP_VERSION=1.0.0
APP_ENV=development

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql://postgres:password@localhost:5432/research_platform

LOG_LEVEL=INFO

UPLOAD_DIR=uploads

ARXIV_BASE_URL=http://export.arxiv.org/api/query
OPENALEX_BASE_URL=https://api.openalex.org

PDF_STORAGE_DIR=D:/FYP/main/storage/papers
PDF_DOWNLOAD_DIR=D:/FYP/main/storage/downloads

CORS_ORIGINS=http://localhost:3001,http://192.168.137.1:3001

# LLM Provider API Keys (leave blank to skip that provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# LLM Provider Settings
# Set any *_ENABLED to false to hard-disable that provider
# (useful to keep a provider out of the fallback chain without
# removing its API key). Set a per-provider *_TIMEOUT to override
# the global LLM_TIMEOUT for that provider (0/unset => use LLM_TIMEOUT).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_ENABLED=true

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_ENABLED=true

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=true

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_ENABLED=true

# Which LLM provider to try first (name must match a registered provider),
# and fallback order (comma-separated). The architecture is a free-tier
# chain (groq/gemini/openrouter) with ollama/local as final fallback.
LLM_DEFAULT_PROVIDER=ollama
LLM_FALLBACK_CHAIN=ollama

# LLM generation parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120.0

# Redis (leave blank to run without cache)
REDIS_URL=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Upload Limits
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=200

# Connectivity Checking
CONNECTIVITY_CHECK_INTERVAL=30
CONNECTIVITY_TIMEOUT=5.0
